# Use a specific Ubuntu base image for reproducibility
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
ARG DISPLAY=:0
ENV DISPLAY=$DISPLAY

# Install required packages for system and font installation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    software-properties-common \
    wget \
    unzip \
    fontconfig \
    git \
    python3-pip \
    python3-dev \
    # Clean up
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Monaco and Consolas fonts
RUN mkdir -p /usr/share/fonts/truetype/custom \
    # Install Monaco font
    && wget -O /usr/share/fonts/truetype/custom/Monaco_Linux.ttf "http://www.gringod.com/wp-upload/software/Fonts/Monaco_Linux.ttf" \
    # Install Consolas font (using YaHei Consolas Hybrid, a common and functional version on Linux)
    && wget -O /tmp/YaHei.Consolas.1.12.zip https://storage.googleapis.com/google-code-archive-downloads/v2/code.google.com/uigroupcode/YaHei.Consolas.1.12.zip \
    && unzip /tmp/YaHei.Consolas.1.12.zip -d /tmp \
    && mv /tmp/YaHei.Consolas.1.12.ttf /usr/share/fonts/truetype/custom/YaHei.Consolas.Hybrid.ttf \
    # Clean up and refresh font cache
    && rm -rf /tmp/YaHei.Consolas.1.12.zip /tmp/YaHei.Consolas.1.12.ttf /tmp/__MACOSX \
    && fc-cache -f -v

# Install Python packages
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
    numpy \
    typing-extensions \
    pytest \
    future \
    cachetools \
    jupyter-client \
    traitlets \
    gin-config \
    jupyter notebook \
    tensorboard \
    absl-py \
    yapf \
    scipy \
    scikit-image \
    matplotlib \
    scikit-learn \
    seaborn \
    mediapy \
    imageio \
    rawpy \
    optuna \
    scikit-optimize \
    hyperopt \
    pyomo \
    flax \
    cr-sparse \
    jaxopt \
    optimistix \
    jupyterlab-fonts

RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /pysim

EXPOSE 8888 
EXPOSE 6666